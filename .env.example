# Copiez ce fichier en `.env` et renseignez la configuration Web de votre projet Firebase
# (Console Firebase > Paramètres du projet > Vos applications > SDK Web).
# Sans ces variables, l'app tourne en « mode démo » : catalogue local, sans compte.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
